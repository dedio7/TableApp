# --- HIDDEN FOLDERS AND FILES ---
# Exclude all hidden folders (folders starting with .)
.*/
# Exclude all hidden files (files starting with .)
.*
# Re-include .gitignore so it can be tracked
!.gitignore

# --- ANDROID / GRADLE ---
.gradle/
.idea/
build/
app/build/
local.properties
*.iml

# --- BUILD ARTIFACTS ---
*.apk
*.ap_
*.aab
*.dex
*.class
bin/
gen/
out/

# --- KOTLIN ---
.kotlin/
kotlin-daemon-embeddable-*.jar

# --- LOGS ---
logcat.txt
*.log

# --- SENSITIVE DATA ---
*.jks
*.keystore
secrets.properties
keystore.properties

# --- OS GENERATED ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE SPECIFIC ---
*.ipr
*.iws
.vscode/
.history/
